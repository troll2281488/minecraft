# Player world saves — local only, never committed.
# Rooted with a leading slash so this matches ONLY /saves/ at the repo root.
# An unrooted "saves/" would also swallow tests/saves/, which must stay tracked:
# those are the golden regression saves proving old worlds still open on new builds.
/saves/

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Python bytecode from serve.py
__pycache__/
*.pyc

# Scratch
*.log
tmp/
scratch/
